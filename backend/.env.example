# ============================================================
# Go Auth Service - 配置模板
# 复制为 .env 后根据环境修改，**不要提交真实 .env**
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
APP_ENV=development
HTTP_PORT=8080

# ------------------------------------------------------------
# PostgreSQL（复用现有 agent-infra 里的 Postgres）
# ------------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=agent_system
PG_USER=postgres
PG_PASSWORD=your_password
PG_SSL_MODE=disable

# ------------------------------------------------------------
# Redis（复用现有 agent-infra 里的 Redis）
# ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# ★ 必须与 Python Agent 侧 agent/.env 的 REDIS_DB **完全一致**（当前是 0）。
# 原因：P3 计费的用量计数是「Agent 写、Go 读」——两边用同一个 Redis 的
# 同一个 DB。DB 号不一致时 Go 读到的计数永远是 0，配额完全失效，
# 而且**不会报任何错**（Redis 眼里只是「这个库是空的」），极难排查。
REDIS_DB=0

# ------------------------------------------------------------
# JWT（RS256 非对称签名，首次启动自动生成密钥对）
# ------------------------------------------------------------
JWT_ALGORITHM=RS256
JWT_ISSUER=auth-service
# 留空则自动生成到 ./keys/ 目录
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
KEYS_DIR=./keys

# ------------------------------------------------------------
# Agent Service（Python Agent）
# ------------------------------------------------------------
AGENT_SERVICE_URL=http://127.0.0.1:1111
AGENT_TIMEOUT=30s

# ------------------------------------------------------------
# Rate Limit
# ------------------------------------------------------------
LOGIN_IP_LIMIT=5
LOGIN_IP_WINDOW=1m
LOGIN_USER_LIMIT=10
LOGIN_USER_WINDOW=1m
REGISTER_IP_LIMIT=10
REGISTER_IP_WINDOW=1m

# ------------------------------------------------------------
# P3 计费 / 配额
# ------------------------------------------------------------
# 总开关：false = 全部放行（排障 / 内测用）
QUOTA_ENABLED=true
# 默认套餐：user_plans 表里没有记录的用户用这一组额度（0 = 不限）
DEFAULT_PLAN_CODE=free
QUOTA_CHAT_PER_DAY=200
QUOTA_SEARCH_PER_DAY=50
QUOTA_TASK_PER_DAY=10

# 管理后台 API 的共享令牌（请求头 X-Admin-Token）
# 留空 = 管理端点整体返回 404（连"存在管理接口"都不对外暴露）
ADMIN_TOKEN=
