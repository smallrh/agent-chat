# 复制成 .env 后填入真实值：  cp .env.example .env
# 本文件只放占位值，**不要提交真实密钥**（密钥一律只在本地 .env 里）

# ---------------- 应用 ----------------
APP_HOST=0.0.0.0
APP_PORT=8000
RELOAD=true

# ---------------- LLM ----------------
OPENAI_API_KEY=sk-REPLACE-ME
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_STREAM=true
MAX_TOKENS=4096
TEMPERATURE=0.7
# LLM 调用超时（秒）：客户端级 + 每次请求级
LLM_TIMEOUT_SECONDS=120

# ---------------- Embedding（LM Studio 本地） ----------------
EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=text-embedding-nomic-embed-text-v1.5
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ---------------- 外部 HTTP 工具 ----------------
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_URL=https://api.open-meteo.com/v1/forecast

# 联网搜索（留空则工具返回"未配置 Key"，不会报错）
EXA_API_KEY=
WEB_SEARCH_API_KEY=
WEB_SEARCH_PROVIDER=exa

# ---------------- PostgreSQL ----------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=smart_customer
PG_USER=postgres
PG_PASSWORD=REPLACE-ME
PG_POOL_SIZE=10

# ---------------- Redis ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_KEY_PREFIX=agent:
REDIS_CONV_TTL=604800

# ---------------- Qdrant ----------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_KNOWLEDGE=knowledge_base
QDRANT_COLLECTION_LTM=long_term_memory
QDRANT_COLLECTION_AGENT=agent_memory
QDRANT_VECTOR_SIZE=768

# ---------------- MinIO ----------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-files
MINIO_SECURE=false

# ---------------- Kafka ----------------
KAFKA_HOST=127.0.0.1
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_MEMORY_TOPIC=memory.events
KAFKA_CONSUMER_GROUP=agent-memory-group
KAFKA_MEMORY_TASK_TOPIC=memory.tasks
KAFKA_MEMORY_WORKER_GROUP=agent-memory-worker-group

# ---------------- 可观测性 ----------------
METRICS_ENABLED=true
# 留空=不校验；生产建议配置，或在 Go 网关层禁掉 /metrics 的外部访问
METRICS_TOKEN=
